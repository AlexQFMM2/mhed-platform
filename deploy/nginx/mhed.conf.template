# Replace the host and certificate placeholders before enabling this file.

limit_req_zone $binary_remote_addr zone=mhed_api:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=mhed_login:10m rate=5r/m;

server {
    listen 80;
    listen [::]:80;
    server_name __WEB_HOST__ __ADMIN_HOST__ __API_HOST__ __DESK_HOST__;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __WEB_HOST__;
    ssl_certificate /etc/letsencrypt/live/__CERT_NAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CERT_NAME__/privkey.pem;
    client_max_body_size 1m;
    location / { proxy_pass http://127.0.0.1:18101; include proxy_params; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __ADMIN_HOST__;
    ssl_certificate /etc/letsencrypt/live/__CERT_NAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CERT_NAME__/privkey.pem;
    client_max_body_size 1m;

    location = /api/v1/auth/login {
        limit_req zone=mhed_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:18100/v1/auth/login;
        include proxy_params;
    }
    location /api/ {
        limit_req zone=mhed_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:18100/;
        include proxy_params;
    }
    location / { proxy_pass http://127.0.0.1:18102; include proxy_params; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __API_HOST__ __DESK_HOST__;
    ssl_certificate /etc/letsencrypt/live/__CERT_NAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CERT_NAME__/privkey.pem;
    client_max_body_size 1m;

    location = /v1/auth/login {
        limit_req zone=mhed_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:18100;
        include proxy_params;
    }
    location = /v1/desktop/auth/login {
        limit_req zone=mhed_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:18100;
        include proxy_params;
    }
    location / {
        limit_req zone=mhed_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:18100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
