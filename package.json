{
  "name": "mhed-platform",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "check": "pnpm --recursive --if-present run check",
    "dev:web": "pnpm --filter @mhed/web dev",
    "dev:admin": "pnpm --filter @mhed/admin dev"
  }
}
